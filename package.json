{
  "name": "crm-sucursal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/kill-port.js",
    "dev": "set NODE_OPTIONS=--max-old-space-size=1536 && next dev --hostname 0.0.0.0",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --hostname 0.0.0.0",
    "dev:fix": "node scripts/kill-port.js && node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:csv": "node scripts/migrate-csv.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "chart.js": "^4.5.1",
    "csv-parse": "7.0.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.17.0",
    "next": "16.3.3",
    "react": "19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5",
    "vitest": "5.0.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
